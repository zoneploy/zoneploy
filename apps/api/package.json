{
  "name": "@zoneploy/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- tsx src/db/migrate.ts",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e ../../.env.local -- tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@simplewebauthn/server": "^13.3.0",
    "@zoneploy/addons": "workspace:*",
    "@zoneploy/runtime": "workspace:*",
    "@zoneploy/types": "workspace:*",
    "acme-client": "^5.4.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "nanoid": "^5.0.0",
    "node-ssh": "^13.2.0",
    "otplib": "^13.4.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.29.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
