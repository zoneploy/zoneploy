{
  "name": "zoneploy",
  "private": false,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @zoneploy/types build && pnpm --filter @zoneploy/addons build && pnpm --filter @zoneploy/runtime build && pnpm -r --if-present typecheck",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "ws": "^8.20.0"
  }
}
